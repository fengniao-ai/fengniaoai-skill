{
  "schema_version": "1.0",
  "package": "fengniaoai-skill",
  "artifact_delivery": {
    "auto_download": true,
    "control_fields": {
      "download_artifacts": {
        "type": "boolean",
        "default": true
      },
      "output_dir": {
        "type": "string",
        "default": "<cwd>/output/fengniaoai-skill/<timestamp>-<action>-<short-id>"
      },
      "filename_prefix": {
        "type": "string"
      }
    },
    "environment": [
      "FENGNIAO_AUTO_DOWNLOAD",
      "FENGNIAO_OUTPUT_DIR",
      "FENGNIAO_MAX_DOWNLOAD_BYTES",
      "FENGNIAO_DOWNLOAD_TIMEOUT_MS"
    ],
    "artifact_fields": ["type", "role", "url", "local_path"],
    "failure_policy": "keep_api_success_and_remote_url",
    "skip_roles": ["source"],
    "reference": "references/actions.md"
  },
  "actions": {
    "account.configure": {
      "label": "配置蜂鸟AI",
      "skill": "fengniaoai-skill",
      "status": "active",
      "description": "安全接收 Key 页面复制的 Project ID 和 Api key，并保存到用户级配置文件。",
      "triggers": ["配置蜂鸟AI", "连接蜂鸟AI", "设置API Key", "粘贴Key"],
      "required": ["config"],
      "optional": [],
      "defaults": {},
      "input_modes": ["stdin"],
      "response_mode": "sync",
      "command": "node scripts/fengniaoai.mjs account configure --input-stdin",
      "ask_if_missing": {
        "config": "请到蜂鸟AI Key 页面点击“复制给 Agent”，再把复制的两行内容粘贴到这个可信的私有对话。"
      },
      "reference": "references/getting-started.md"
    },
    "account.balance": {
      "label": "查询剩余点数",
      "skill": "fengniaoai-skill",
      "status": "active",
      "description": "查询当前 Project ID 可用的蜂鸟AI 点数。",
      "triggers": ["剩余点数", "查询点数", "点数余额", "还有多少点"],
      "required": [],
      "optional": ["channel", "uid"],
      "defaults": {
        "channel": "fengn"
      },
      "input_modes": ["json"],
      "response_mode": "sync",
      "command": "node scripts/fengniaoai.mjs account balance",
      "ask_if_missing": {},
      "reference": "references/account-and-errors.md"
    },
    "skill.check-update": {
      "label": "检查 Skill 更新",
      "skill": "fengniaoai-skill",
      "status": "active",
      "description": "低频检查 GitHub 上是否存在更新版本；结果缓存 24 小时，不影响正常业务任务。",
      "triggers": ["检查Skill更新", "检查更新", "Skill升级", "升级蜂鸟AI"],
      "required": [],
      "optional": ["force", "cache_hours"],
      "defaults": {
        "force": false,
        "cache_hours": 24
      },
      "input_modes": ["json"],
      "response_mode": "sync",
      "command": "node scripts/fengniaoai.mjs skill check-update",
      "ask_if_missing": {},
      "reference": "references/getting-started.md"
    },
    "product.scrape": {
      "label": "采集商品资料与图片",
      "skill": "fengniao-product-insight",
      "status": "active",
      "description": "从 1688、淘宝/天猫或 Amazon 商品详情页采集结构化资料，并将完整 product.json 和主图、SKU 图、详情图分目录下载到本地；用户要求分析 URL 商品时，后续必须联合 product.json 与图片证据生成 analysis/product-analysis.md。",
      "triggers": ["采集商品信息", "解析商品链接", "分析商品链接", "下载1688商品", "获取1688商品", "下载商品图片", "读取淘宝商品", "读取Amazon商品"],
      "required": ["url"],
      "optional": ["platform", "customer_id", "image_groups", "output_dir", "download_artifacts"],
      "defaults": {
        "image_groups": ["main", "sku", "detail"],
        "download_artifacts": true
      },
      "input_modes": ["json", "https-url"],
      "response_mode": "sync",
      "command": "node scripts/fengniaoai.mjs product scrape",
      "ask_if_missing": {
        "url": "请提供 1688、淘宝/天猫或 Amazon 的完整商品详情页链接。"
      },
      "failure_policy": {
        "scope": "current_product_url_workflow",
        "terminal_for_url_workflow": true,
        "automatic_retry": false,
        "allow_browser_fallback": false,
        "allow_downstream_actions": false,
        "unrelated_actions_allowed": true,
        "safe_next_steps": [
          "retry_original_url_with_user_confirmation",
          "provide_another_trusted_product_url",
          "upload_trusted_product_materials"
        ]
      },
      "downstream_gate": {
        "required": {
          "data.workflow_ready_for_downstream": true,
          "workflow.state": "ready",
          "workflow.allow_downstream_actions": true
        },
        "on_blocked": {
          "scope": "current_product_url_workflow",
          "automatic_retry": false,
          "allow_browser_fallback": false,
          "allow_downstream_actions": false,
          "unrelated_actions_allowed": true,
          "requires_user_confirmation_for_retry": true
        }
      },
      "reference": "references/product-workflow.md"
    },
    "image.analyze": {
      "label": "识图分析",
      "skill": "fengniao-product-insight",
      "status": "active",
      "description": "分析商品图、详情长图或界面截图的可见内容，并将自然语言分析保存为本地 Markdown；分析 URL 商品或在套图流程中选择分析后规划时，完整读取 product.json，对全部去重主图逐张调用，并联合页面字段与图片证据生成 analysis/product-analysis.md。",
      "triggers": ["分析图片", "识图分析", "分析商品图", "分析详情页", "分析截图", "看看图片里有什么", "提取商品视觉信息"],
      "required": ["image"],
      "optional": ["customer_id", "analysis_id", "output_dir", "download_artifacts"],
      "defaults": {
        "download_artifacts": true
      },
      "input_modes": ["local-path", "data-url", "asset-key"],
      "response_mode": "sync",
      "command": "node scripts/fengniaoai.mjs image analyze",
      "ask_if_missing": {
        "image": "请提供要分析的本地图片；如果是商品链接，我可以先采集并下载图片。"
      },
      "reference": "references/product-workflow.md"
    },
    "image.generate": {
      "label": "从零生成图片",
      "skill": "fengniao-image-generate",
      "status": "active",
      "description": "根据文字描述从零生成海报、封面、商品场景图或创意视觉。",
      "triggers": ["生成图片", "生成一张图", "文生图", "做一张海报", "生成海报", "生成封面", "生成商品图", "商品场景图", "营销图"],
      "required": ["prompt"],
      "optional": ["aspect_ratio", "model_alias", "customer_id", "output_dir", "filename_prefix", "download_artifacts"],
      "defaults": {
        "aspect_ratio": "1:1",
        "model_alias": "tpro-1k"
      },
      "input_modes": ["json"],
      "response_mode": "sync",
      "command": "node scripts/fengniaoai.mjs image generate",
      "ask_if_missing": {
        "prompt": "你想生成什么画面？说清主体、场景或用途中的一两项就可以，其余我来帮你补全。"
      },
      "reference": "references/image-generation.md"
    },
    "image.transform": {
      "label": "参考图改图",
      "skill": "fengniao-image-generate",
      "status": "active",
      "description": "参考现有图片换背景、换场景、改风格，并尽量保持指定人物、商品或构图。",
      "triggers": ["修改图片", "编辑图片", "参考这张图", "照这张图改", "换背景", "换场景", "改风格", "保持商品", "白底图", "白底主图", "做成白底", "纯白背景"],
      "required": ["image|reference_images|reference_image_urls", "prompt"],
      "optional": ["aspect_ratio", "model_alias", "customer_id", "reference_roles", "reference_mode", "output_dir", "filename_prefix", "download_artifacts"],
      "defaults": {
        "aspect_ratio": "original",
        "model_alias": "tpro-1k"
      },
      "input_modes": ["https-url", "data-url", "local-path"],
      "response_mode": "sync",
      "command": "node scripts/fengniaoai.mjs image transform",
      "ask_if_missing": {
        "image|reference_images|reference_image_urls": "请提供一张或多张本地图片或 HTTPS 参考图片；多张图片请按主图、补充角度或细节的顺序提供。",
        "prompt": "你希望保留什么、改变什么？例如“保留商品和包装文字，把背景换成夏日海边”。"
      },
      "reference": "references/image-generation.md"
    },
    "image.expand": {
      "label": "扩图与比例转换",
      "skill": "fengniao-image-generate",
      "status": "active",
      "description": "自然补全画面外区域，将图片扩为横版、竖版、方图或指定比例。",
      "triggers": ["扩图", "图片扩图", "扩展图片", "扩成横版", "扩成竖版", "改成16:9", "补全背景", "比例转换"],
      "required": ["image|reference_images|reference_image_urls", "aspect_ratio"],
      "optional": ["prompt", "model_alias", "customer_id", "reference_roles", "reference_mode", "output_dir", "filename_prefix", "download_artifacts"],
